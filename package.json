{
  "name": "peachy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute peachy-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute peachy-db --remote --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "wrangler": "^4.135.0",
    "typescript": "^5.7.0",
    "@cloudflare/workers-types": "^5.20260920.0"
  }
}
