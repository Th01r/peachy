{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peachy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "MAX_ACTIVE_JOBS": "150",
    "LAUNCH_PRICE": "65",
    "REGULAR_PRICE": "79",
    "LAUNCH_PRICE_ENDS": "2026-11-10T23:59:59Z"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peachy-db"
    }
  ]
}
